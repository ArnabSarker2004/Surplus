{
  "name": "surplus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A calmer way to plan your student finances.",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web,ml \"tsx watch backend/src/index.ts\" \"vite --host 127.0.0.1\" \"npm run intelligence:dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx backend/src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/finance.test.ts tests/plaid.test.ts tests/live-plaid.test.ts tests/api.test.ts tests/resources.test.ts tests/auth.test.ts tests/identity.test.ts tests/identity-config.test.ts tests/identity-protocol.test.ts tests/intelligence.test.ts",
    "test:e2e": "playwright test",
    "verify:plaid": "tsx scripts/verify-sandbox.ts",
    "plaid:check-banks": "tsx scripts/check-canadian-banks.ts",
    "auth:check": "tsx scripts/check-auth.ts",
    "db:check": "tsx scripts/database.ts",
    "db:migrate": "tsx scripts/database.ts --migrate",
    "db:import-local": "tsx scripts/import-local.ts",
    "test:postgres": "node --import tsx --test tests/postgres.test.ts tests/postgres-identity.test.ts tests/postgres-intelligence.test.ts",
    "test:e2e:postgres": "playwright test --config playwright.postgres.config.ts",
    "format": "prettier --write frontend backend shared tests scripts *.json *.ts *.js README.md docs/architecture.md",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "intelligence:setup": "tsx scripts/intelligence.ts --setup",
    "intelligence:dev": "tsx scripts/intelligence.ts",
    "test:intelligence": "tsx scripts/intelligence.ts --test",
    "test:e2e:intelligence": "playwright test --config playwright.intelligence.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-plaid-link": "^4.0.1",
    "recharts": "^2.15.4",
    "sql.js": "^1.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9.30.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "eslint": "9.30.1",
    "globals": "^16.2.0",
    "prettier": "^3.9.7",
    "supertest": "^7.1.1",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "^6.4.1"
  }
}
