# Optional banking settings. Demo Mode needs no Plaid credentials; create a local account in the app.
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
# Optional live Canadian banking (Trial/Production). Enables Connect my bank.
# Sandbox keeps its own secret; environments are stored per connection.
PLAID_PRODUCTION_SECRET=
# Optional extra calls, only after confirming your current Plaid Trial includes them.
# Leave blank on paid/unknown plans. Confirmation expires after 30 days.
PLAID_PLAN=
PLAID_TRIAL_CONFIRMED_ON=
# Optional existing sandbox access token; never prefix secrets with VITE_.
PLAID_SANDBOX_ACCESS_TOKEN=
# 64 hex characters (32 bytes). If empty, a local key is generated in ignored data/.
TOKEN_ENCRYPTION_KEY=
PORT=3001

# PostgreSQL enables separate accounts. Omit for the local SQLite owner workspace.
# Keep this server-side; percent-encode special characters in the password.
DATABASE_URL=
# Optional trusted CA file; Supabase uses the bundled public CA certificate.
DATABASE_CA_FILE=

# Authentication: keep all values server-side. See docs/authentication.md.
# Exact public browser origin; register callbacks under this origin with each provider.
AUTH_PUBLIC_ORIGIN=http://localhost:5173
# Optional 64-hex-character signing key. When omitted, a persistent key is generated in SQLite.
JWT_SIGNING_KEY=

# Google/Microsoft walkthrough: docs/social-login-setup.md. Check: npm run auth:check
# Google OAuth: Web application. Callback: /api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft Entra: Web platform, personal + organizational accounts.
# Callback: /api/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Email codes: authenticated SMTP from Resend, Postmark, SES, SendGrid, or another provider.
# Use a verified sender. STARTTLS on 587, or implicit TLS on 465; no plaintext SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local Python financial intelligence (optional overrides; no external AI API key needed).
INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8001
# At least 32 characters if set; otherwise generated at data/.intelligence-key.
INTELLIGENCE_SERVICE_TOKEN=

# Optional merchant suggestions; server/Python only. Keep this key out of chat and VITE_ variables.
# Create a free Groq account, then opt in from the transaction review panel.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
